#include <mpi.h>

int main() {
    int rank, size, i, n, chunk;
    int full[1000], part[1000];

    MPI_Init(NULL, NULL);
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);

    if (rank == 0) {
        printf("Enter array size (divisible by %d): ", size);
        fflush(stdout);
        scanf("%d", &n);
        printf("Enter %d elements: ", n);
        fflush(stdout);
        for (i = 0; i < n; i++)
            scanf("%d", &full[i]);
    }

    MPI_Bcast(&n, 1, MPI_INT, 0, MPI_COMM_WORLD);

    if (n % size != 0) {
        if (rank == 0)
            printf("Array size must be divisible by number of processes\n");
        MPI_Finalize();
        return 0;
    }

    chunk = n / size;

    MPI_Scatter(full, chunk, MPI_INT, part, chunk, MPI_INT, 0, MPI_COMM_WORLD);

    printf("Process %d received:", rank);
    for (i = 0; i < chunk; i++)
        printf(" %d", part[i]);
    printf("\n");

    MPI_Finalize();
    return 0;
}




