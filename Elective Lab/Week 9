#include <mpi.h>

#define MAX 50

int main() {
    int rank, size, i, j, n, rows;
    int A[MAX * MAX], x[MAX], y[MAX];
    int local_A[MAX * MAX], local_y[MAX];

    MPI_Init(NULL, NULL);
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);
    MPI_Comm_size(MPI_COMM_WORLD, &size);

    if (rank == 0) {
        printf("Enter N (divisible by %d): ", size);
        fflush(stdout);
        scanf("%d", &n);
        printf("Enter matrix A (%d x %d):\n", n, n);
        fflush(stdout);
        for (i = 0; i < n; i++)
            for (j = 0; j < n; j++)
                scanf("%d", &A[i * n + j]);
        printf("Enter vector x (%d elements): ", n);
        fflush(stdout);
        for (i = 0; i < n; i++)
            scanf("%d", &x[i]);
    }

    MPI_Bcast(&n, 1, MPI_INT, 0, MPI_COMM_WORLD);

    if (n % size != 0) {
        if (rank == 0)
            printf("N must be divisible by number of processes\n");
        MPI_Finalize();
        return 0;
    }

    rows = n / size;

    MPI_Scatter(A, rows * n, MPI_INT, local_A, rows * n, MPI_INT, 0, MPI_COMM_WORLD);
    MPI_Bcast(x, n, MPI_INT, 0, MPI_COMM_WORLD);

    printf("Process %d: Scatter A part:", rank);
    for (i = 0; i < rows; i++) {
        printf(" [");
        for (j = 0; j < n; j++)
            printf("%d%s", local_A[i * n + j], j < n - 1 ? "," : "");
        printf("]");
    }
    printf("\n");

    for (i = 0; i < rows; i++) {
        local_y[i] = 0;
        for (j = 0; j < n; j++)
            local_y[i] += local_A[i * n + j] * x[j];
    }

    printf("Process %d: Computed y_part =", rank);
    for (i = 0; i < rows; i++)
        printf(" %d", local_y[i]);
    printf("\n");

    MPI_Gather(local_y, rows, MPI_INT, y, rows, MPI_INT, 0, MPI_COMM_WORLD);

    if (rank == 0) {
        printf("Process 0: Final y = [");
        for (i = 0; i < n; i++)
            printf("%d%s", y[i], i < n - 1 ? ", " : "");
        printf("]\n");
    }

    MPI_Finalize();
    return 0;
}

