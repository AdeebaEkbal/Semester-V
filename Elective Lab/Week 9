#include <stdlib.h>
#include <time.h>
#include <mpi.h>

int main() {
    int rank, value, gmax, gmin;

    MPI_Init(NULL, NULL);
    MPI_Comm_rank(MPI_COMM_WORLD, &rank);

    srand(time(NULL) + rank);
    value = rand() % 1000;

    MPI_Allreduce(&value, &gmax, 1, MPI_INT, MPI_MAX, MPI_COMM_WORLD);
    MPI_Allreduce(&value, &gmin, 1, MPI_INT, MPI_MIN, MPI_COMM_WORLD);

    printf("Process %d generated %d. Global Max: %d, Global Min: %d\n", rank, value, gmax, gmin);

    MPI_Finalize();
    return 0;
}





